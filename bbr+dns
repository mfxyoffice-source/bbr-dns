def cmd_auto(args):
    """全自动：先测速、再调优 —— 实测带宽(自动装 Ookla CLI) -> 开 BBR -> 调 sysctl（TCP buffer / conntrack）。
    默认不含 DNS 缓存（DNS 会改 resolv.conf、停用 systemd-resolved，影响面较大，需要显式 --with-dns-cache 才会做）。
    也不做任何出口限速相关的操作。
    """
    require_root()

    logging.info("===== 全自动调优模式：先测速、再调优（不含限速） =====")

    iface = args.iface or detect_default_iface()
    if not iface:
        logging.warning("自动探测网卡失败，跳过网卡自报速率探测，可用 --iface 指定或 --link-mbit 手动指定带宽")

    established = detect_established_connections()

    last_known = read_last_known_speed()
    speed_mbit = None
    trust_this_value = False
    speedtest_detail = None

    # 带宽探测优先级：手动指定 > 实测测速(Ookla，真实带宽) > 网卡自报(ethtool/sysfs，
    # 虚拟网卡常见虚报) > 历史记录 > 保守默认值。
    # 先测速再调优：这里在开 BBR / 调 sysctl 之前就把这一步做完，后面的 buffer 分档
    # 才是基于真实测出来的数字，而不是网卡自己吹的数字。
    # 注意：不管当前并发连接数多高，都会照常实测，不做"高并发时跳过测速"的判断——
    # 如果你的机器本身流量很大、担心测速结果被干扰，测完自己核对一下数字是否合理即可。
    if args.link_mbit:
        speed_mbit = args.link_mbit
        trust_this_value = True
        logging.info("使用手动指定的链路速率: %smbit", speed_mbit)
    elif args.no_speedtest:
        logging.info("已加 --no-speedtest，跳过实测，改用网卡自报速率")
    else:
        logging.info("第一步：先测速再调优，用 Ookla CLI 实测真实带宽 ...")
        r = detect_link_speed_via_speedtest(server_id=args.server_id)
        speedtest_detail = r
        up_mbit = r.get("up_mbit") if r else None
        down_mbit = r.get("down_mbit") if r else None
        if up_mbit:
            candidate = int(up_mbit)
            src = r.get("server_name") or "未知节点"
            logging.info(
                "实测完成（节点: %s）: 上传≈%.1fmbit 下载≈%.1fmbit",
                src, up_mbit, down_mbit or 0,
            )
            speed_mbit = candidate
            trust_this_value = True
        else:
            logging.warning("实测未能完成（可能是这台机器出不了公网、被墙，或没有 root 权限自动安装 Ookla CLI）")

    if not speed_mbit and iface:
        eth_speed = detect_link_speed_mbit(iface)
        if eth_speed:
            speed_mbit = eth_speed
            trust_this_value = True
            logging.info("退回网卡自报速率: %smbit（虚拟网卡上这个数字可能不准）", speed_mbit)

    if not speed_mbit and last_known:
        speed_mbit = int(last_known)
        trust_this_value = True
        logging.warning("这次没能探测到任何真实速率，沿用上次记录的 %smbit", speed_mbit)

    if not speed_mbit:
        speed_mbit = 1000
        trust_this_value = False
        logging.warning("最终没能测出真实速率，使用保守默认值 %smbit（仅影响 TCP buffer 分档，本版本不限速）。", speed_mbit)

    if trust_this_value:
        write_last_known_speed(speed_mbit)

    logging.info("第二步：开始调优 —— 开 BBR + 调 sysctl（基于上面测出的 %smbit）", speed_mbit)
    do_enable_bbr(apply=True)

    if not args.no_sysctl_tune:
        do_tune_sysctl(apply=True, speed_mbit=speed_mbit, established=established)

    if args.with_dns_cache:
        logging.info("已加 --with-dns-cache，继续配置本地 DNS 缓存（仅本机可用，除非另加 --allow-cidr）")
        do_setup_dns_cache(
            apply=True,
            allow_cidrs=args.allow_cidr or [],
            disable_systemd_resolved=not args.no_disable_systemd_resolved,
        )

    install_self()

    if args.link_mbit:
        speed_source = "手动指定"
    elif speedtest_detail and speedtest_detail.get("up_mbit"):
        speed_source = "实测（%s）" % (speedtest_detail.get("server_name") or "Ookla")
    elif trust_this_value:
        speed_source = "网卡自报/历史记录"
    else:
        speed_source = "保守默认值"

    print(f"""
======================================================================
全自动调优完成（先测速、再调优：BBR + sysctl{' + DNS缓存' if args.with_dns_cache else ''}，不含限速）。

带宽依据    : {speed_mbit}mbit（来源: {speed_source}，仅用于 TCP buffer 分档）
查看当前状态: python3 {os.path.join(INSTALL_DIR, "auto-tune.py")} check
如需重新实测：{os.path.join(INSTALL_DIR, "auto-tune.py")} auto
======================================================================
""")


def read_tty_line(prompt):
    try:
        with open("/dev/tty", "r") as tty:
            sys.stdout.write(prompt)
            sys.stdout.flush()
            line = tty.readline()
        return line.rstrip("\n")
    except OSError:
        return None


def run_menu():
    require_root()
    print("""
======================================================================
  auto-tune — VPS 网络调优（BBR + sysctl + 可选本地DNS缓存，不含限速）
======================================================================
  1) 全自动调优   探测网卡/带宽 -> 开 BBR -> 调 sysctl  [默认]
  2) 只读检查     查看当前 BBR / sysctl / DNS 状态，不改任何东西
  3) 测速         安装/使用 Ookla CLI 测真实带宽，识别测速服务器信息
  4) 本地 DNS 缓存 安装配置 unbound，仅监听本机，不对公网开放
  0) 退出
======================================================================""")
    raw = read_tty_line("请输入数字后回车（直接回车 = 1）: ")
    if raw is None:
        logging.warning("没有检测到可用终端（/dev/tty 不可用），无法交互，默认执行「全自动调优」")
        choice = "1"
    else:
        choice = raw.strip() or "1"

    if choice == "1":
        # 回车默认走这条：探测带宽(自动装 Ookla CLI 并先测速) -> 开 BBR -> 调 sysctl，
        # 一次性跑完整个链路，中途不再需要任何交互。
        cmd_auto(argparse.Namespace(
            iface=None, link_mbit=None,
            no_speedtest=False, no_sysctl_tune=False,
            no_install_ookla=False, server_id=None,
            with_dns_cache=False, allow_cidr=None, no_disable_systemd_resolved=False,
        ))
    elif choice == "2":
        cmd_check(argparse.Namespace())
    elif choice == "3":
        cmd_speedtest(argparse.Namespace(no_install_ookla=False, list_servers=False, server_id=None))
    elif choice == "4":
        logging.info("默认只允许本机查询（127.0.0.1），不对公网开放。如需给内网其他机器用，用命令行 --allow-cidr 指定网段。")
        cmd_dns_cache(argparse.Namespace(
            apply=True, allow_cidr=None, no_disable_systemd_resolved=False,
            skip_latency_test=False, test_host=None,
        ))
    elif choice == "0":
        print("已退出，未做任何修改。")
        sys.exit(0)
    else:
        print(f"无效输入: {choice!r}，未做任何修改。")
        sys.exit(1)


def main():
    ap = argparse.ArgumentParser(description="auto-tune: BBR + sysctl + 可选本地DNS缓存（单文件版，不含限速）")
    sub = ap.add_subparsers(dest="command")

    p_check = sub.add_parser("check", help="只读检查当前 BBR/sysctl/DNS 状态")
    p_check.set_defaults(func=cmd_check)

    p_bbr = sub.add_parser("enable-bbr", help="开启 BBR + fq")
    p_bbr.add_argument("--apply", action="store_true", help="真正写入并生效；不加则只打印计划")
    p_bbr.set_defaults(func=cmd_enable_bbr)

    p_sysctl = sub.add_parser("tune-sysctl", help="调 TCP buffer / conntrack 表大小 / 常规网络参数（跟 BBR 分开管理）")
    p_sysctl.add_argument("--speed-mbit", dest="speed_mbit", type=int,
                           help="按这个链路速率决定 buffer 大小，不给则用历史记录，都没有则按保守档位处理")
    p_sysctl.add_argument("--apply", action="store_true", help="真正写入并生效；不加则只打印计划")
    p_sysctl.set_defaults(func=cmd_tune_sysctl)

    p_auto = sub.add_parser("auto", help="全自动：先测速、再调优 —— 探测带宽 -> 开 BBR -> 调 sysctl，一步到位（不含限速）")
    p_auto.add_argument("--iface", help="手动指定网卡，仅在需要网卡自报速率兜底时用，不给则自动探测默认路由网卡")
    p_auto.add_argument("--link-mbit", dest="link_mbit", type=int,
                         help="手动指定链路速率(Mbit)，仅用于 TCP buffer 分档，指定后跳过测速直接使用这个值")
    p_auto.add_argument("--no-speedtest", dest="no_speedtest", action="store_true",
                         help="不做实测，直接用网卡自报速率/历史记录/默认值（默认会优先实测）")
    p_auto.add_argument("--no-sysctl-tune", dest="no_sysctl_tune", action="store_true",
                         help="不要自动调 TCP buffer/conntrack 表大小等常规 sysctl 参数（默认会调）")
    p_auto.add_argument("--no-install-ookla", dest="no_install_ookla", action="store_true",
                         help="测速时不要自动安装 Ookla CLI（默认没装会自动装，需要 root 且能访问 packagecloud.io）；"
                              "加了这个之后如果没装 Ookla CLI，会直接跳过实测走网卡自报/历史记录")
    p_auto.add_argument("--server-id", dest="server_id",
                         help="指定 Ookla 测速服务器 ID，不给则用延迟最低的自动最优节点")
    p_auto.add_argument("--with-dns-cache", dest="with_dns_cache", action="store_true",
                         help="同时安装配置本地 unbound DNS 缓存（默认仅本机可用；会停用 systemd-resolved 并改写 resolv.conf）")
    p_auto.add_argument("--allow-cidr", dest="allow_cidr", action="append",
                         help="配合 --with-dns-cache 使用：额外放行的信任网段（如内网段），可重复传多次；"
                              "不传则 DNS 缓存只允许本机查询")
    p_auto.add_argument("--no-disable-systemd-resolved", dest="no_disable_systemd_resolved", action="store_true",
                         help="配合 --with-dns-cache 使用：不要停用/禁用 systemd-resolved，也不改 resolv.conf，"
                              "只安装配置 unbound 本身（适合你想自己手动接管切换的场景）")
    p_auto.set_defaults(func=cmd_auto)

    p_speedtest = sub.add_parser("speedtest", help="用 Ookla 官方 CLI 测一次真实上传/下载速度并识别测速服务器信息")
    p_speedtest.add_argument("--no-install-ookla", dest="no_install_ookla", action="store_true",
                              help="没装 Ookla CLI 时不要自动安装（默认没装会自动装，需要 root 权限）")
    p_speedtest.add_argument("--list-servers", dest="list_servers", action="store_true",
                              help="只列出附近可用的测速服务器（id/名称/位置），不测速；没装 Ookla CLI 会先自动装")
    p_speedtest.add_argument("--server-id", dest="server_id",
                              help="指定测速服务器 ID（配合 --list-servers 查到的 id 使用），不给则自动选最优节点")
    p_speedtest.set_defaults(func=cmd_speedtest)

    p_dns = sub.add_parser("dns-cache", help="安装配置本地 unbound DNS 缓存（默认仅本机可用，不对公网开放）")
    p_dns.add_argument("--apply", action="store_true", help="真正安装/写入并生效；不加则只打印计划")
    p_dns.add_argument("--allow-cidr", dest="allow_cidr", action="append",
                        help="额外放行的信任网段（如内网段 10.0.0.0/8），可重复传多次；"
                             "不传则只允许 127.0.0.1 本机查询，绝不会默认放行公网")
    p_dns.add_argument("--no-disable-systemd-resolved", dest="no_disable_systemd_resolved", action="store_true",
                        help="不要停用/禁用 systemd-resolved，也不改 /etc/resolv.conf，只安装配置 unbound 本身")
    p_dns.add_argument("--skip-latency-test", dest="skip_latency_test", action="store_true",
                        help="配置完不做 ping 延迟测试")
    p_dns.add_argument("--test-host", dest="test_host", action="append",
                        help="自定义延迟测试的目标主机，可重复传多次；不传则用默认列表 (1.1.1.1 8.8.8.8 www.baidu.com)")
    p_dns.set_defaults(func=cmd_dns_cache)

    args = ap.parse_args()
    setup_logging()

    if args.command is None:
        run_menu()
    else:
        args.func(args)


if __name__ == "__main__":
    main()

