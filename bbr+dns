#!/bin/bash

echo "🚀 开始智能网络调优..."

# ========= 检测工具 =========
if ! command -v curl &> /dev/null; then
    apt update && apt install -y curl
fi

if ! command -v ping &> /dev/null; then
    apt install -y iputils-ping
fi

# ========= 安装测速工具 =========
if ! command -v speedtest &> /dev/null; then
    echo "📦 安装 speedtest..."
    apt install -y speedtest-cli || apt install -y speedtest
fi

# ========= 获取带宽 =========
echo "📊 测试带宽中..."
speed=$(speedtest-cli --simple 2>/dev/null | grep Download | awk '{print $2}')

if [ -z "$speed" ]; then
    echo "⚠️ speedtest失败，默认100Mbps"
    speed=100
fi

echo "👉 当前带宽: ${speed} Mbps"

# ========= 获取延迟 =========
echo "📡 测试延迟中..."
rtt=$(ping -c 4 8.8.8.8 | tail -1 | awk -F '/' '{print $5}')

if [ -z "$rtt" ]; then
    rtt=50
fi

echo "👉 当前延迟: ${rtt} ms"

# ========= 计算缓冲 =========
if (( $(echo "$speed < 100" | bc -l) )); then
    buffer=16777216   # 16MB
elif (( $(echo "$speed < 500" | bc -l) )); then
    buffer=33554432   # 32MB
else
    buffer=67108864   # 64MB
fi

echo "👉 使用缓冲区: $buffer"

# ========= 判断是否高并发（机场） =========
conntrack=262144

if (( $(echo "$speed > 200" | bc -l) )); then
    conntrack=1048576
fi

# ========= 写入配置 =========
cat > /etc/sysctl.d/99-auto-tune.conf <<EOF
# BBR
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr

# Buffer
net.core.rmem_max=$buffer
net.core.wmem_max=$buffer
net.ipv4.tcp_rmem=4096 87380 $buffer
net.ipv4.tcp_wmem=4096 87380 $buffer

# Performance
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_tw_reuse=1

# High concurrency (机场优化)
net.netfilter.nf_conntrack_max=$conntrack
net.ipv4.ip_local_port_range=1024 65535
net.core.somaxconn=65535
net.core.netdev_max_backlog=4096
EOF

# ========= 应用 =========
sysctl --system

# ========= 验证 =========
echo ""
echo "✅ 调优完成！"
sysctl net.ipv4.tcp_congestion_control
sysctl net.core.rmem_max
sysctl net.netfilter.nf_conntrack_max
