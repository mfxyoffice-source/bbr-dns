def get_ookla_binary():
    return shutil.which("speedtest")


def _do_install_ookla():
    """实际安装逻辑，不做 root 检查（由调用方决定要不要硬性要求 root）。"""
    if get_ookla_binary():
        logging.info("检测到已安装 Ookla speedtest CLI，跳过安装")
        return True

    if shutil.which("apt-get"):
        logging.info("检测到 apt，按 Ookla 官方仓库脚本安装 speedtest CLI ...")
        run("curl -s https://packagecloud.io/install/repositories/ookla/speedtest-cli/script.deb.sh | bash", check=False, timeout=60)
        run("apt-get install -y speedtest", check=False, timeout=60)
    elif shutil.which("yum") or shutil.which("dnf"):
        logging.info("检测到 yum/dnf，按 Ookla 官方仓库脚本安装 speedtest CLI ...")
        run("curl -s https://packagecloud.io/install/repositories/ookla/speedtest-cli/script.rpm.sh | bash", check=False, timeout=60)
        pkg_mgr = "dnf" if shutil.which("dnf") else "yum"
        run(f"{pkg_mgr} install -y speedtest", check=False, timeout=60)
    else:
        logging.error("未识别到 apt/yum/dnf，无法自动安装，请参考 https://www.speedtest.net/apps/cli 手动安装")
        return False

    if get_ookla_binary():
        logging.info("Ookla speedtest CLI 安装成功: %s", get_ookla_binary())
        return True
    logging.error("安装后仍未检测到 speedtest 可执行文件，请手动检查安装日志或网络访问")
    return False


def install_ookla_cli():
    """显式安装入口（硬性要求 root，权限不够直接退出）：用于用户主动要求安装的场景。"""
    require_root()
    return _do_install_ookla()


def ensure_ookla_installed():
    """自动测速前的静默确保步骤：已装则直接返回 True；没装且是 root 则自动装；
    不是 root 则只警告一句，不中断整个流程（调用方会因为拿不到 binary 而优雅地报错）。"""
    if get_ookla_binary():
        return True
    if os.geteuid() != 0:
        logging.warning("未安装 Ookla speedtest CLI，且当前非 root，无法自动安装。请用 sudo 重跑，或手动安装: https://www.speedtest.net/apps/cli")
        return False
    logging.info("未检测到 Ookla speedtest CLI，自动安装中 ...")
    return _do_install_ookla()


def list_ookla_servers():
    binary = get_ookla_binary()
    if not binary:
        logging.error("未安装 Ookla speedtest CLI，无法列出服务器（自动安装可能因权限或网络原因失败，可手动运行 speedtest --list-servers 重试，或参考 https://www.speedtest.net/apps/cli 手动安装）")
        return []
    out = run(f"{binary} --servers --accept-license --accept-gdpr -f json 2>/dev/null", check=False, timeout=20)
    try:
        data = json.loads(out)
        return data.get("servers", [])
    except (json.JSONDecodeError, AttributeError):
        text = run(f"{binary} --servers --accept-license --accept-gdpr 2>/dev/null", check=False, timeout=20)
        return text


def run_ookla_speedtest(server_id=None, timeout=60):
    binary = get_ookla_binary()
    if not binary:
        return None

    server_arg = f"--server-id={server_id}" if server_id else ""
    cmd = f"{binary} {server_arg} --accept-license --accept-gdpr -f json 2>/dev/null"
    logging.info("使用 Ookla CLI 测速中（多线程，通常耗时 10~30 秒）...")
    out = run(cmd, check=False, timeout=timeout)
    try:
        data = json.loads(out)
    except (json.JSONDecodeError, TypeError):
        logging.warning("Ookla CLI 输出解析失败，原始输出: %s", (out or "")[:300])
        return None

    def bandwidth_to_mbit(bw):
        if bw is None:
            return None
        try:
            return float(bw) * 8 / 1_000_000
        except (TypeError, ValueError):
            return None

    down = data.get("download", {})
    up = data.get("upload", {})
    ping = data.get("ping", {})
    server = data.get("server", {})
    result = data.get("result", {})

    return {
        "down_mbit": bandwidth_to_mbit(down.get("bandwidth")),
        "up_mbit": bandwidth_to_mbit(up.get("bandwidth")),
        "ping_ms": ping.get("latency"),
        "jitter_ms": ping.get("jitter"),
        "server_name": server.get("name"),
        "server_location": f"{server.get('location', '')} ({server.get('country', '')})".strip(),
        "server_host": server.get("host"),
        "isp": data.get("isp"),
        "result_url": result.get("url"),
    }


def detect_link_speed_via_speedtest(server_id=None, no_install=False):
    """统一测速入口：只用 Ookla 官方 CLI，没有内置兜底测速。
    没装且允许自动安装（未加 no_install 且当前是 root）时会先自动装上再测；
    装不上或测速失败，直接返回 None，交给调用方走下一优先级（网卡自报/历史记录/默认值）。"""
    if not no_install:
        ensure_ookla_installed()

    if not get_ookla_binary():
        logging.warning("Ookla speedtest CLI 不可用，跳过实测这一步")
        return None

    r = run_ookla_speedtest(server_id=server_id)
    if r and (r.get("down_mbit") or r.get("up_mbit")):
        return r
    logging.warning("Ookla CLI 测速未取得有效结果")
    return None


def print_speedtest_result(r):
    if not r:
        print("测速失败：下载/上传均未测出结果")
        return
    print("=" * 70)
    print("测速结果")
    print("=" * 70)
    if r.get("server_name"):
        loc = f"  @ {r['server_location']}" if r.get("server_location") else ""
        print(f"测速节点  : {r['server_name']}{loc}")
    if r.get("isp"):
        print(f"识别 ISP  : {r['isp']}")
    if r.get("ping_ms") is not None:
        jitter = f"  抖动 {r['jitter_ms']:.1f}ms" if r.get("jitter_ms") is not None else ""
        print(f"延迟(ping): {r['ping_ms']:.1f}ms{jitter}")
    print(f"下载速度  : {r['down_mbit']:.1f} Mbit/s" if r.get("down_mbit") else "下载速度  : 测速失败")
    print(f"上传速度  : {r['up_mbit']:.1f} Mbit/s" if r.get("up_mbit") else "上传速度  : 测速失败")
    if r.get("result_url"):
        print(f"结果链接  : {r['result_url']}")


def cmd_speedtest(args):
    if not args.no_install_ookla:
        ensure_ookla_installed()

    if args.list_servers:
        servers = list_ookla_servers()
        if isinstance(servers, list) and servers:
            print("附近可用测速服务器（挑一个固定用，比如同机房/同线路厂商，方便结果可比较）：")
            for s in servers[:15]:
                print(f"  id={s.get('id')}\t{s.get('name')}\t{s.get('location')}, {s.get('country')}")
        elif isinstance(servers, str) and servers.strip():
            print(servers)
        else:
            print("未能列出服务器（可能未安装 Ookla CLI，或网络无法访问 speedtest.net）")
        return

    r = detect_link_speed_via_speedtest(server_id=args.server_id, no_install=args.no_install_ookla)
    print_speedtest_result(r)


def read_last_known_speed():
    try:
        with open(STATE_PATH) as f:
            return float(f.read().strip())
    except (OSError, ValueError):
        return None


def write_last_known_speed(mbit):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(STATE_PATH, "w") as f:
            f.write(f"{mbit}\n")
    except OSError:
        pass


def detect_established_connections():
    out = run("ss -tan state established 2>/dev/null | wc -l", check=False).strip()
    try:
        n = int(out)
        return max(0, n - 1)
    except ValueError:
        return None


# --------------------------------------------------------------------------
# 本地 DNS 缓存（unbound）
# --------------------------------------------------------------------------

def detect_cpu_count():
    try:
        n = os.cpu_count()
        return n if n and n > 0 else 1
    except Exception:
        return 1


def detect_mem_mb():
    """读 /proc/meminfo 拿总内存（MB），比依赖外部 free 命令更少一个依赖。读取失败返回 None。"""
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    kb = int(line.split()[1])
                    return kb // 1024
    except (OSError, ValueError, IndexError):
        pass
    return None


def compute_dns_cache_size_kb(mem_mb):
    """按内存分档给 unbound 的 msg-cache / rrset-cache 定大小（单位 KB，配置文件里写作 'Nk'）。"""
    if mem_mb is None or mem_mb <= 2048:
        return 20000
    if mem_mb <= 8192:
        return 50000
    return 100000


def build_unbound_conf(num_threads, cache_kb, allow_cidrs):
    """生成 unbound.conf 内容。access-control 默认只放行本机（127.0.0.0/8、::1/128），
    allow_cidrs 是用户显式加的额外白名单网段——绝不默认放行 0.0.0.0/0，
    避免这台机器变成公网可用的开放 DNS 递归解析器（DNS 放大攻击的常见跳板）。"""
    access_lines = ["    access-control: 127.0.0.0/8 allow", "    access-control: ::1/128 allow"]
    for cidr in allow_cidrs:
        access_lines.append(f"    access-control: {cidr} allow")

    interfaces = ["    interface: 127.0.0.1"]
    if allow_cidrs:
        # 只有显式加了信任网段时才监听所有接口（否则给内网用也收不到包）；
        # 没加任何 --allow-cidr 时只监听回环地址，从物理上保证进不来外部流量。
        interfaces = ["    interface: 0.0.0.0", "    interface: ::0"]

    return "server:\n" + \
        "    verbosity: 1\n" + \
        "\n".join(interfaces) + "\n" + \
        "\n".join(access_lines) + "\n" + \
        f"    num-threads: {num_threads}\n" + \
        f"    msg-cache-size: {cache_kb}k\n" + \
        f"    rrset-cache-size: {cache_kb}k\n" + \
        "    cache-max-ttl: 86400\n" + \
        "    cache-min-ttl: 3600\n" + \
        "    prefetch: yes\n" + \
        "    hide-identity: yes\n" + \
        "    hide-version: yes\n" + \
        "    use-caps-for-id: yes\n" + \
        "    harden-glue: yes\n" + \
        "    harden-dnssec-stripped: yes\n" + \
        "    qname-minimisation: yes\n"


def backup_file(path, backup_dir, label):
    if not os.path.exists(path):
        return None
    os.makedirs(backup_dir, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_path = os.path.join(backup_dir, f"{label}-{ts}.bak")
    shutil.copy2(path, backup_path) if not os.path.islink(path) else None
    if os.path.islink(path):
        target = os.readlink(path)
        with open(backup_path, "w") as f:
            f.write(f"# 原 {path} 是指向 {target} 的符号链接\n")
    logging.info("已备份 %s 到 %s", path, backup_path)
    return backup_path


def do_setup_dns_cache(apply, allow_cidrs, disable_systemd_resolved=True):
    require_root()
    established = detect_established_connections()
    cpu = detect_cpu_count()
    mem_mb = detect_mem_mb()
    cache_kb = compute_dns_cache_size_kb(mem_mb)

    if allow_cidrs:
        logging.warning(
            "你指定了额外放行网段: %s —— unbound 将对这些网段开放递归解析。"
            "务必确认这些网段是你信任的内网/私有网络，不要放行公网段（如 0.0.0.0/0），"
            "否则这台机器很容易被当成 DNS 放大攻击的跳板，还可能被云厂商判定异常流量。",
            ", ".join(allow_cidrs),
        )
    conf_content = build_unbound_conf(cpu, cache_kb, allow_cidrs)

    logging.info(
        "计划配置 unbound（CPU=%s核 内存=%sMB -> 缓存=%sk 线程=%s，监听范围=%s）：\n%s",
        cpu, mem_mb, cache_kb, cpu,
        "仅本机 127.0.0.1" if not allow_cidrs else "0.0.0.0 + 白名单网段",
        conf_content,
    )

    if not apply:
        logging.info("[dry-run] 未加 --apply，不会真正安装/写入。确认无误后加 --apply 执行。")
        return False

    # 1. 安装 unbound（+ dns-root-data 提供根提示文件）
    if not shutil.which("unbound"):
        logging.info("安装 unbound ...")
        if not install_packages(["unbound", "dns-root-data"]):
            logging.error("unbound 安装失败，终止")
            return False
    else:
        logging.info("unbound 已安装，跳过安装步骤")

    # 2. 备份并写入 unbound.conf
    backup_file(UNBOUND_CONF, UNBOUND_BACKUP_DIR, "unbound.conf")
    os.makedirs(os.path.dirname(UNBOUND_CONF), exist_ok=True)
    with open(UNBOUND_CONF, "w") as f:
        f.write(conf_content)

    checkconf_out = run("unbound-checkconf", check=False)
    if "no errors" not in checkconf_out.lower() and "no error" not in checkconf_out.lower() and checkconf_out.strip():
        # unbound-checkconf 正常时通常输出 "unbound-checkconf: no errors in ..."；
        # 没匹配到关键字也不直接判失败（不同版本措辞可能略有差异），只是把原始输出记下来供你核对
        logging.info("unbound-checkconf 输出: %s", checkconf_out.strip())
    run("systemctl enable unbound", check=False)
    restart_ok = subprocess.run("systemctl restart unbound", shell=True, timeout=20).returncode == 0
    if not restart_ok:
        logging.error("unbound 启动失败，请用 `journalctl -u unbound -e` 查看原因；未修改 /etc/resolv.conf")
        return False
    logging.info("unbound 已启动并设为开机自启")

    # 3. 切换本机 DNS 到 127.0.0.1（仅在 unbound 确认启动成功后才动 resolv.conf）
    if disable_systemd_resolved:
        run("systemctl stop systemd-resolved", check=False)
        run("systemctl disable systemd-resolved", check=False)

    backup_file(RESOLV_CONF, RESOLV_BACKUP_DIR, "resolv.conf")
    if os.path.islink(RESOLV_CONF):
        target = os.readlink(RESOLV_CONF)
        logging.info("/etc/resolv.conf 原本是指向 %s 的符号链接，先移除链接再写入静态文件", target)
        os.unlink(RESOLV_CONF)
    with open(RESOLV_CONF, "w") as f:
        f.write("nameserver 127.0.0.1\n")
    logging.info("已将 /etc/resolv.conf 指向本地 unbound（127.0.0.1）")
    logging.warning(
        "注意：部分发行版的 NetworkManager/systemd-resolved 重启网络服务或系统重启后，"
        "可能会重新生成 /etc/resolv.conf 覆盖这次改动。如果发现改动没保留住，"
        "需要在对应的网络管理工具里禁用它对 resolv.conf 的自动管理，脚本不做进一步处理。"
    )
    return True


def cmd_dns_cache(args):
    allow_cidrs = args.allow_cidr or []
    do_setup_dns_cache(
        apply=args.apply,
        allow_cidrs=allow_cidrs,
        disable_systemd_resolved=not args.no_disable_systemd_resolved,
    )
    if args.apply and not args.skip_latency_test:
        test_dns_latency(args.test_host or DEFAULT_DNS_TEST_HOSTS)


def test_dns_latency(hosts):
    print("=" * 70)
    print("DNS / 网络延迟测试")
    print("=" * 70)
    for host in hosts:
        out = run(f"ping -c 3 {host} 2>/dev/null", check=False, timeout=10)
        last_line = out.strip().splitlines()[-1] if out.strip() else "(无响应，可能超时或不可达)"
        print(f"{host:20s} {last_line}")


