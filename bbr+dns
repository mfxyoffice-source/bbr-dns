# auto-tune.sh —— 一键安装/运行入口（bash 外壳 + 内嵌 Python payload）
#
# 用法：
#   bash <(curl -Ls https://raw.githubusercontent.com/mfxyoffice-source/auto-tune/main/auto-tune.sh)
#
set -euo pipefail
INSTALL_DIR="/opt/auto-tune"
CONFIG_DIR="/etc/auto-tune"
PY_PATH="$INSTALL_DIR/auto-tune.py"
if [[ "$(id -u)" -ne 0 ]]; then
    echo "请用 root 权限运行" >&2
    exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo "未找到 python3，请先安装后重试" >&2
    exit 1
fi
mkdir -p "$INSTALL_DIR" "$CONFIG_DIR"
cat > "$PY_PATH" <<'PYEOF'
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
auto-tune.py — 单文件版 VPS 网络调优工具（不含出口限速功能）

集成能力：
  1. BBR / 拥塞控制调优（check / enable-bbr）
  2. TCP buffer / conntrack 表 / 常规网络参数调优（tune-sysctl）
  3. 真实带宽探测（speedtest），用 Ookla 官方 CLI 多线程实测，没装会自动安装（需要 root）
  4. 本地 DNS 缓存（dns-cache），基于 unbound，按 CPU/内存自动分配线程数和缓存大小

已移除的功能：不再包含任何 tc / htb 出口带宽限速、AIMD 动态调速、
优先级 IP 分流、systemd 常驻限速服务。这个版本只负责"调优"，不负责"限速"。

设计原则：
  - 默认只读、只打印计划，不改配置；任何真正下发变更的动作都需要显式 --apply。
  - 改 sysctl / DNS 前自动备份，可回滚。
  - 单文件、无第三方 Python 依赖，装好 python3 就能跑。
  - 测速只用 Ookla 官方 CLI（不再内置 Cloudflare 粗测兜底）；没装会在需要测速时自动安装（需要
    root 和能访问 packagecloud.io），实在装不上则跳过测速，直接退回网卡自报/历史记录/保守默认值，
    不会中断整个调优流程。
  - 先测速、再调优：auto 命令固定顺序是"实测带宽 -> 开 BBR -> 调 sysctl"，
    buffer 分档用的是测出来的真实数字，而不是虚拟网卡自己虚报的速率。
  - 交互菜单直接回车 = 执行「全自动调优」这整条链路（测速+装CLI+开BBR+调sysctl），
    中途不再需要额外确认。
  - dns-cache 默认只允许本机（127.0.0.0/8、::1/128）查询，绝不默认开放给公网——
    开放给 0.0.0.0/0 的递归解析器很容易被当成 DNS 放大攻击的跳板，云厂商也可能因此封号。
    如果确实需要给内网其他机器提供服务，用 --allow-cidr 显式加白名单网段。

============================== 一键安装 ==============================
curl -fsSL https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_REPO_NAME/main/auto-tune.py | sudo python3 -
========================================================================
跑起来后会弹出数字菜单，直接回车 = 默认执行「全自动调优」，不需要再敲任何参数。

菜单：
  1) 全自动调优（默认）  探测网卡/带宽 -> 开 BBR -> 调 sysctl
  2) 只读检查            查看当前 BBR/sysctl/DNS 状态，不改任何东西
  3) 测速                安装/使用 Ookla CLI 测真实带宽，识别测速服务器信息
  4) 本地 DNS 缓存       安装配置 unbound，仅监听本机，不对公网开放
  0) 退出

也支持直接带子命令跑（脚本自动化 / CI 场景用，跳过菜单）：
  sudo python3 auto-tune.py check
  sudo python3 auto-tune.py enable-bbr --apply
  sudo python3 auto-tune.py tune-sysctl --apply
  sudo python3 auto-tune.py speedtest                       # 测速+识别服务器信息
  sudo python3 auto-tune.py speedtest                         # 没装 Ookla CLI 会自动先装再测
  sudo python3 auto-tune.py dns-cache --apply                 # 装 unbound，仅本机可用
  sudo python3 auto-tune.py dns-cache --apply --allow-cidr 10.0.0.0/8   # 额外放行内网段
  sudo python3 auto-tune.py auto                              # --link-mbit 不给则自动测速
"""

